---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile-section">
        <div class="profile-sidebar">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded profile-portrait' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
        30vw, 95vw"{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}

          <!-- Social (moved here, under the picture) -->
          {% if page.social %}
            <div class="social sidebar-social">
              <div class="contact-icons">{% include social.liquid %}</div>
              <div class="contact-note">{{ site.contact_note }}</div>
            </div>
          {% endif %}
        </div>

        <div class="profile-text">{{ content }}</div>
      </div>
    {% else %}
      <div class="clearfix">{{ content }}</div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

<style>
  .profile-section {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .profile-sidebar {
    flex: 0 0 170px;
    max-width: 170px;
    display: flex;
    flex-direction: column;
  }

  /* Smaller, portrait-shaped image */
  .profile-sidebar .profile-portrait {
    width: 100%;
    height: 190px;
    object-fit: cover;
    object-position: top center;
  }

  .profile-text {
    flex: 1 1 auto;
    min-width: 0; /* lets long text wrap normally instead of overflowing */
  }

  .sidebar-social {
    margin-top: 0.6rem;
    width: 100%;
    text-align: center;
  }

  /* Force icons onto a single line and shrink them to fit the sidebar width */
  .sidebar-social .contact-icons {
    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: center;
    align-items: center;
    gap: 0.35rem;
  }

  .sidebar-social .contact-icons a {
    font-size: 1.1rem !important;
    margin: 0 !important;
    line-height: 1 !important;
  }

  .sidebar-social .contact-icons i,
  .sidebar-social .contact-icons svg {
    font-size: 1.1rem !important;
    width: 1.1rem !important;
    height: 1.1rem !important;
  }

  .sidebar-social .contact-note {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    line-height: 1.25;
  }

  /* Stack into a single column on small screens */
  @media (max-width: 768px) {
    .profile-section {
      flex-direction: column;
    }
    .profile-sidebar {
      flex: 0 0 auto;
      width: 100%;
      max-width: 170px;
      margin: 0 auto 1.5rem auto;
    }
  }
</style>
